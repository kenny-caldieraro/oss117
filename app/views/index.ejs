<%- include('./partials/header') %>

<main>
  <section class="hero">
    <div class="hero__text">
      <p class="kicker">Les meilleures répliques, servies par une API</p>
      <h1 class="hero__title">OSS<span>117</span><span class="sr-only"> : les répliques cultes</span></h1>
      <h2 class="hero__subtitle">Le Caire, nid d'API</h2>

      <%- include('./partials/dossier', { quote }) %>

      <div class="actions">
        <button class="btn btn--glitch" id="getQuote" type="button">Une autre réplique</button>
        <button class="btn btn--ghost" id="copyQuote" type="button">Copier</button>
      </div>
    </div>

    <div class="hero__visual">
      <%- include('./partials/hero-image') %>
    </div>
  </section>

  <section class="films" id="films">
    <div class="films__inner">
      <p class="kicker">Les archives</p>
      <h2 class="section-title">Les répliques par film</h2>
      <ul class="films__grid">
        <% films.forEach(function (film) { %>
        <li>
          <a class="film-card" href="/film/<%= film.slug %>">
            <span class="film-card__count"><%= film.count %> répliques<% if (film.year) { %> · <%= film.year %><% } %></span>
            <span class="film-card__name"><%= film.shortName %></span>
          </a>
        </li>
        <% }) %>
      </ul>
      <p class="films__all"><a href="/repliques">Voir toutes les répliques →</a></p>
    </div>
  </section>

  <section class="api" id="api">
    <div class="api__inner">
      <p class="kicker">Ordre de mission</p>
      <h2 class="section-title">L'API</h2>
      <p class="api__intro">
        Gratuite, sans clé, en JSON. Cliquez sur un endpoint pour voir la réponse en direct.
      </p>

      <div class="api__grid">
        <ul class="endpoints">
          <li>
            <button class="endpoint is-active" type="button" data-path="quote/random">
              <span class="endpoint__verb">GET</span>
              <code>/api/v1/quote/random</code>
              <span class="endpoint__desc">Une réplique au hasard</span>
            </button>
          </li>
          <li>
            <button class="endpoint" type="button" data-path="quote/42">
              <span class="endpoint__verb">GET</span>
              <code>/api/v1/quote/:id</code>
              <span class="endpoint__desc">Une réplique précise</span>
            </button>
          </li>
          <li>
            <button class="endpoint" type="button" data-path="quote/all">
              <span class="endpoint__verb">GET</span>
              <code>/api/v1/quote/all</code>
              <span class="endpoint__desc">Toutes les répliques</span>
            </button>
          </li>
          <li>
            <button class="endpoint" type="button" data-path="perso/Jean-Pierre">
              <span class="endpoint__verb">GET</span>
              <code>/api/v1/perso/:name</code>
              <span class="endpoint__desc">« C'est la piquette, Jack ! » avec le prénom de votre choix</span>
            </button>
          </li>
        </ul>

        <div class="console">
          <div class="console__bar">
            <span class="console__url" id="consoleUrl">GET /api/v1/quote/random</span>
          </div>
          <pre class="console__body" id="consoleBody">{
  "id": 42,
  "content": "Je n'y suis pour rien. C'est l'inexpugnable arrogance de votre beauté qui m'asperge.",
  "author": "Hubert Bonnisseur de la Bath (alias OSS 117)",
  "film": "OSS 117 : Rio ne répond plus"
}</pre>
        </div>
      </div>

      <div class="slack" id="slack">
        <h3>Sur Slack</h3>
        <p>
          Créez une slash command qui pointe en <code>POST</code> vers
          <code>/api/v1/quote/slack_random</code>. Tapez <code>/oss117</code> pour une réplique au hasard,
          ou <code>/oss117 Bob</code> pour envoyer la piquette à Bob.
        </p>
      </div>
    </div>
  </section>
</main>

<%- include('./partials/footer') %>
